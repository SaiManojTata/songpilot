{
  "manifest_version": 3,
  "name": "Songpilot",
  "description": "Voice and hum-controlled AI assistant for Spotify Web Player",
  "version": "0.1",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://open.spotify.com/*"
  ]
}